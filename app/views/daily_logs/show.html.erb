<body>
  <section id="daily_calorie_target"><%= @user.goal.daily_calorie_target %></section>
    <div class="container">
        <header>
            <h1><img src="https://res.cloudinary.com/dz68ybmap/image/upload/v1740221192/dish_f16ncn.png" alt="Logo"> TrackMyPlate</h1>
            <div class="head_water">
              <p>Today</p>
              <button class="water"><p><%= @user.goal.target_water %></p><img src="https://res.cloudinary.com/dz68ybmap/image/upload/v1740221172/water-glass_ftepct.png"></button>
            </div>

        </header>
        <section class="calories">
              <div>
                <% calories_eat = 0 %>
                <% @daily_log.meals.each do |meal| %>
                  <%# <% a = calories_eat %>
                  <% calories_eat = meal.total_calories.round %>
                <% end %>
                <h2 id="remaining_calories"><%= @daily_log.remaining_calories.round - calories_eat %></h2>
                <% calories_eat = 0 %>
                <p>Calories left</p>
              </div>

              <%#<div class="circle-container">
              <svg width="120" height="120" viewBox="0 0 120 120">
                <circle class="circle-progress-circle" cx="60" cy="60" r="50" fill="none" />
                <circle class="circle-progress-value" cx="60" cy="60" r="50" fill="none"
                  stroke-dasharray="314" stroke-dashoffset="314"
                  transform="rotate(-90, 60, 60)" />
                <text class="circle-progress-text" x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" font-size="22px" font-weight="bold" id="progress-text">0%</text>
              </svg>
              </div><%>


              <div class="progress-container">
              <svg width="120" height="120" viewBox="0 0 120 120">
                    <circle class="progress_circle" cx="60" cy="60" r="50" fill="none" />
                    <circle class="progress_value" cx="60" cy="60" r="50" fill="none"
                    stroke-dasharray="314" stroke-dashoffset="314"
                    transform="rotate(90, 60, 60)" />
              </svg>
              <div class="icon"><img src="https://res.cloudinary.com/dz68ybmap/image/upload/v1739604725/calories_xmrfkk.png"></div>
              </div>
        </section>
        <section class="macros">
                <% protein_eat = 0 %>
                <% @daily_log.meals.each do |meal| %>
                  <% protein_eat = meal.total_protein.round %>
                <% end %>

                <% carbs_eat = 0 %>
                <% @daily_log.meals.each do |meal| %>
                  <% carbs_eat = meal.total_carbs.round %>
                <% end %>

                <% fat_eat = 0 %>
                <% @daily_log.meals.each do |meal| %>
                  <% fat_eat = meal.total_fat.round %>
                <% end %>

            <div class="macro">
                <p><strong class="gbold" id="remaining_proteins"><%= @daily_log.remaining_proteins - protein_eat %>g </strong><br> Protein left</p>
                <p class="d-none" id="goal_proteins"><%= @daily_log.remaining_proteins %></p>
                <div class="progress-container-macro">
                  <svg width="80" height="80" viewBox="0 0 80 80">
                      <circle class="progress_circle_macro" cx="40" cy="40" r="30" fill="none" />
                      <circle class="progress_value_macro" id="progress_value_protein" cx="40" cy="80" r="30" fill="none"
                      stroke-dasharray="188" stroke-dashoffset="188"
                      transform="rotate(90, 60, 60)" />
                  </svg>
                  <div class="icon_macro"><img src="https://res.cloudinary.com/dz68ybmap/image/upload/v1742139907/protein_red_b3c07w.png"></div>
                </div>
            </div>
            <div class="macro">
                <p><strong class="gbold" id="remaining_carbs"><%= @daily_log.remaining_carbs - carbs_eat %>g </strong><br> Carbs left</p>
                <p class="d-none" id="goal_carbs"><%= @daily_log.remaining_carbs %></p>
                <div class="progress-container-macro">
                  <svg width="80" height="80" viewBox="0 0 80 80">
                      <circle class="progress_circle_macro" cx="40" cy="40" r="30" fill="none" />
                      <circle class="progress_value_macro" id="progress_value_carbs" cx="40" cy="80" r="30" fill="none"
                      stroke-dasharray="188" stroke-dashoffset="188"
                      transform="rotate(90, 60, 60)" />
                  </svg>
                  <div class="icon_macro"><img src="https://res.cloudinary.com/dz68ybmap/image/upload/v1742139907/starch_orange_unshfa.png"></div>
                </div>
            </div>
            <div class="macro">
                <p><strong class="gbold" id="remaining_fats"><%= @daily_log.remaining_fats - fat_eat %>g </strong><br> Fats left</p>
                <p class="d-none" id="goal_fats"><%= @daily_log.remaining_fats %></p>
                <div class="progress-container-macro">
                  <svg width="80" height="80" viewBox="0 0 80 80">
                      <circle class="progress_circle_macro" cx="40" cy="40" r="30" fill="none" />
                      <circle class="progress_value_macro" id="progress_value_fat" cx="40" cy="80" r="30" fill="none"
                      stroke-dasharray="188" stroke-dashoffset="188"
                      transform="rotate(90, 60, 60)" />
                  </svg>
                  <div class="icon_macro"><img src="https://res.cloudinary.com/dz68ybmap/image/upload/v1742139907/fat_blue_nsqlot.png"></div>
                </div>
            </div>
            <% protein_eat = 0 %>
            <% carbs_eat = 0 %>
            <% fat_eat = 0 %>
        </section>
        <section class="meals">
        <p>Recently uploaded</p>
            <% @daily_log.meals.each do |meal| %>
              <div class="meal">
              <% image = "" %>
              <% if meal.foods.any? && meal.foods.last.food_name == "Burger"
                image = "https://res.cloudinary.com/dz68ybmap/image/upload/v1741274747/burger_xwukmm.jpg"
              elsif meal.foods.any? && meal.foods.last.food_name == "Pancakes"
                image = "https://res.cloudinary.com/dz68ybmap/image/upload/v1741274694/panacakes_whyntg.jpg"
              elsif meal.foods.any? && meal.foods.last.food_name == "Salad"
                image = "https://res.cloudinary.com/dz68ybmap/image/upload/v1741274694/salad_rfh2oz.jpg"
              elsif meal.foods.any? && meal.foods.last.food_name == "Pasta"
                image = "https://res.cloudinary.com/dz68ybmap/image/upload/v1741274695/pasta_dljae6.jpg"
              elsif meal.foods.any? && meal.foods.last.food_name == "Pizza"
                image = "https://res.cloudinary.com/dz68ybmap/image/upload/v1741274696/pizza_ufpsjn.webp"
              elsif meal.foods.any? && meal.foods.last.food_name == "Fish"
                image = "https://res.cloudinary.com/dz68ybmap/image/upload/v1741274848/fish_jvzbzq.webp"
              elsif meal.foods.any? && meal.foods.last.food_name== "Steak"
                image = "https://res.cloudinary.com/dz68ybmap/image/upload/v1741274848/steak_bzlfoi.jpg"
              elsif meal.foods.any? && meal.foods.last.food_name == "Chicken"
                image = "https://res.cloudinary.com/dz68ybmap/image/upload/v1741274848/chicken_qs5cea.jpg"
              elsif meal.foods.any? && meal.foods.last.food_name == "Kebab"
                image = "https://res.cloudinary.com/dz68ybmap/image/upload/v1741274694/lamb-shish-kebab-20_lhosbq.jpg"
              end %>
                <img class="meal-image" src= "<%= image %>" alt="Repas">
                <div class="meal-info">
                    <div class="meal-header">
                        <h3><%= link_to "#{meal.meal_type}", daily_log_meal_path(@daily_log.id, meal.id) %></h3>
                        <span class="meal-time"><%= meal.eaten_at.strftime("%H:%M") %></span>
                    </div>
                    <p class="meal-calories">
                        <img src="https://res.cloudinary.com/dz68ybmap/image/upload/v1739604725/calories_xmrfkk.png" class="icons"> <%= meal.total_calories.round %> kcal
                    </p>
                    <div class="meal-macros">
                        <p><img src="https://res.cloudinary.com/dz68ybmap/image/upload/v1739604767/meat_zs6xru.png" alt="Protein"> <%= meal.total_protein.round %>g</p>
                        <p><img src="https://res.cloudinary.com/dz68ybmap/image/upload/v1739604767/starch_cstc5l.png" alt="Carbs"> <%= meal.total_carbs.round %>g</p>
                        <p><img src="https://res.cloudinary.com/dz68ybmap/image/upload/v1739604767/fat_svz8zd.png" alt="Fats"> <%= meal.total_fat.round %>g</p>
                    </div>
                </div>
              </div>
            <% end %>
        </section>
        <div class="idea-button">
        <%= link_to "#", class: "idea-icon", data: { bs_toggle: "modal", bs_target: "#ideaPopup" } do %>
          <i class="fas fa-lightbulb"></i>
        <% end %>
        </div>
        <button class="add-meal"><%= link_to "+", new_daily_log_meal_path(@daily_log.id, @meal) %></button>
    </div>
</body>

<div class="modal fade" id="ideaPopup" tabindex="-1" aria-labelledby="ideaPopupLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="ideaPopupLabel">Suggestion</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <% client = OpenAI::Client.new
        chatgpt_response = client.chat(parameters: {
          model: "gpt-3.5-turbo",
          messages: [{ role: "user", content: "Tu es un expert en nutrition. Ta tâche consiste à proposer des repas en fonction des calories, protéines, glucides, lipides restants et en fonction de son objectif. Voici les données: calories = #{@daily_log.remaining_calories}, protéines = #{@daily_log.remaining_proteins}, glucides = #{@daily_log.remaining_carbs}, lipides = #{@daily_log.remaining_fats}, objectif = #{@user.goal.goal_type}. Renvoie uniquement les repas avec des gros espaces pour plus de visibilité avec les données en premier et les repas avec les données du repas."}]
        })
        @content = chatgpt_response["choices"][0]["message"]["content"] %>

      <%= @content %>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>


<script>
  function updateProgressCircle() {
  // Calorie data
  const goal = parseInt(document.getElementById("daily_calorie_target").textContent);
  let consumed = parseInt(document.getElementById("remaining_calories").textContent);
  consumed = goal - consumed
  const percent = Math.min((consumed / goal) * 100, 100);

  // Update circle progress
  const circle = document.querySelector(".progress_value");
  const circumference = 314;
  circle.style.strokeDashoffset = circumference - (circumference * percent / 100);
  }

  function updateProgressCircleProtein() {
  // Calorie data
  const goal = parseInt(document.getElementById("goal_proteins").textContent);
  let consumed = parseInt(document.getElementById("remaining_proteins").textContent);
  consumed = goal - consumed
  const percent = Math.min((consumed / goal) * 100, 100);

  // Update circle progress
  const circle = document.getElementById("progress_value_protein");
  const circumference = 188;
  circle.style.strokeDashoffset = circumference - (circumference * percent / 100);
  }

  function updateProgressCircleCarbs() {
  // Calorie data
  const goal = parseInt(document.getElementById("goal_carbs").textContent);
  let consumed = parseInt(document.getElementById("remaining_carbs").textContent);
  consumed = goal - consumed
  const percent = Math.min((consumed / goal) * 100, 100);

  // Update circle progress
  const circle = document.getElementById("progress_value_carbs");
  const circumference = 188;
  circle.style.strokeDashoffset = circumference - (circumference * percent / 100);
  }

  function updateProgressCircleFat() {
  // Calorie data
  const goal = parseInt(document.getElementById("goal_fats").textContent);
  let consumed = parseInt(document.getElementById("remaining_fats").textContent);
  consumed = goal - consumed
  const percent = Math.min((consumed / goal) * 100, 100);

  // Update circle progress
  const circle = document.getElementById("progress_value_fat");
  const circumference = 188;
  circle.style.strokeDashoffset = circumference - (circumference * percent / 100);
  }

  // WATER

  const maxCountWater = document.querySelector(".water p").textContent;
  let countWater = maxCountWater;
  const buttonElementWater = document.querySelector(".water");

  buttonElementWater.addEventListener("click", () => {
    if (countWater <= maxCountWater) {
        countWater = countWater - 1;
        document.querySelector(".water p").textContent = `${countWater}`;
        if (countWater === 0) {
          buttonElementWater.disabled = true;
        }
    }
  });


updateProgressCircle();
updateProgressCircleProtein();
updateProgressCircleCarbs();
updateProgressCircleFat();

</script>
